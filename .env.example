NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://127.0.0.1:27017/bls_and_company

REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

JWT_ACCESS_SECRET=your-jwt-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

FRONTEND_PUBLIC_URL=http://localhost:5173
FRONTEND_PARTNER_URL=http://localhost:5175
FRONTEND_ADMIN_URL=http://localhost:5176
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# SMTP Email Configuration (Optional for background jobs)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@blscompany.com

# AWS S3 (Optional for production cloud storage)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bls-documents-vault
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payment Gateway Configuration
PAYMENT_PROVIDER=razorpay
PAYMENT_PUBLIC_KEY=rzp_test_placeholder_key
PAYMENT_SECRET_KEY=rzp_test_placeholder_secret
PAYMENT_WEBHOOK_SECRET=rzp_test_webhook_secret
