NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://127.0.0.1:27017/bls_and_company

REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

JWT_ACCESS_SECRET=bls_company_enterprise_jwt_access_secret_key_2026_secure
JWT_REFRESH_SECRET=bls_company_enterprise_jwt_refresh_secret_key_2026_secure
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

FRONTEND_PUBLIC_URL=http://localhost:5173
FRONTEND_PARTNER_URL=http://localhost:5175
FRONTEND_ADMIN_URL=http://localhost:5176
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=notifications@blscompany.com
